export const dynamic = "force-dynamic";

/** Development-discovered, explicitly non-admitting scenario read. */
export async function POST(request) {
  if (import.meta.env.DEV) {
    const { admitLocalDemoCompositionRead } = await import("../../../local-demo/_admission");
    if (await admitLocalDemoCompositionRead(request)) {
      const { handleLocalDemoCompositionRead } = await import("./_handler");
      return handleLocalDemoCompositionRead();
    }
  }
  return Response.json({ error: "not_found" }, {
    status: 404,
    headers: { "cache-control": "no-store", "x-content-type-options": "nosniff" },
  });
}
