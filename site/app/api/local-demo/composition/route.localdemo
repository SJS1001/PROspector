export const dynamic = "force-dynamic";

/** Development-discovered, explicitly non-admitting scenario read. */
async function dispatch(request: Request) {
  if (import.meta.env.DEV) {
    const { admitLocalDemoScenarioRequest } = await import("../../../local-demo/_admission");
    const admission = await admitLocalDemoScenarioRequest(request);
    if (admission instanceof Response) return admission;
    if (admission) {
      const { handleLocalDemoScenario } = await import("./_handler");
      return handleLocalDemoScenario(admission);
    }
  }
  return Response.json({ error: "not_found" }, {
    status: 404,
    headers: { "cache-control": "no-store", "x-content-type-options": "nosniff" },
  });
}

export function GET(request: Request) { return dispatch(request); }
export function POST(request: Request) { return dispatch(request); }
